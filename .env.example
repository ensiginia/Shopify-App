# Shopify CLI supplies these during npm run dev.
# For a manually hosted app, copy this file to .env and use real app credentials.
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SHOPIFY_APP_URL=https://your-app.example.com
SCOPES=write_products,read_orders
# Optional: custom shop domain for Shopify authentication.
# SHOP_CUSTOM_DOMAIN=

# A/B delivery remains disabled until app linking and dev-store QA are completed.
AB_LIVE_ENABLED=false
# Include Shopify test payments only in a development/testing workspace.
AB_INCLUDE_TEST_ORDERS=false
# Optional exact active subscription name that grants A/B testing. Blank = no paid-plan gate.
AB_REQUIRED_SUBSCRIPTION_NAME=

# AI Pages: server-only provider configuration. Never use a VITE_ prefix.
OPENAI_API_KEY=
AI_MODEL=
# Optional supported GPT Image model for original marketing banners.
AI_IMAGE_MODEL=
# Initial app credits per shop; failed/canceled generations return their credit.
AI_INITIAL_CREDITS=5
# Enable only after Shopify grants write_themes exemption and native theme QA passes.
AI_THEME_WRITE_ENABLED=false
# Direct HTTPS mp4/webm tutorial URL; blank shows the written guide.
AI_TUTORIAL_URL=
