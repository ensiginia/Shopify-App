<ss-conversion-block data-kind="rating" data-position="{{ block.settings.position | escape }}" data-full-width="{{ block.settings.full_width }}"  data-proxy="{{ block.settings.proxy_path | escape }}" data-wrap="{{ block.settings.wrap_section }}" data-design="{{ request.design_mode }}" data-add-url="{{ routes.cart_add_url }}.js" data-locale="{{ request.locale.iso_code }}" style="--cb-bg:{{ block.settings.background }};--cb-fg:{{ block.settings.foreground }};--cb-padding:{{ block.settings.padding }}px;--cb-radius:{{ block.settings.radius | default: 8 }}px;--cb-spacing:{{ block.settings.spacing | default: 0 }}px" class="cb-live cb-live-rating cb-live-{{ block.settings.layout }}" {{ block.shopify_attributes }}>{% if block.settings.count > 0 %}<p>{{ block.settings.rating | divided_by: 10.0 }} / 5 — {{ block.settings.count }} <span data-cb-text="label">{{ block.settings.label | escape }}</span></p>{% elsif request.design_mode %}<p>Enter your real average rating and review count.</p>{% endif %}<span class="cb-live-status" role="status" aria-live="polite"></span></ss-conversion-block>
{% schema %}
{
  "name": "Review summary",
  "target": "section",
  "stylesheet": "conversion-blocks.css",
  "javascript": "conversion-blocks.js",
  "settings": [
    {
      "id": "rating",
      "label": "Average rating (tenths)",
      "type": "range",
      "default": 45,
      "min": 0,
      "max": 50,
      "step": 1
    },
    {
      "id": "count",
      "label": "Number of reviews",
      "type": "range",
      "default": 0,
      "min": 0,
      "max": 100,
      "step": 1
    },
    {
      "id": "label",
      "label": "Review label",
      "type": "text",
      "default": "Customer reviews"
    },
    {
      "id": "background",
      "label": "Background",
      "type": "color",
      "default": "#f6f6f6"
    },
    {
      "id": "foreground",
      "label": "Text color",
      "type": "color",
      "default": "#202223"
    },
    {
      "id": "padding",
      "label": "Padding",
      "type": "range",
      "default": 16,
      "min": 0,
      "max": 48,
      "step": 1,
      "unit": "px"
    },
    {
      "id": "proxy_path",
      "label": "App proxy path",
      "type": "text",
      "default": "/apps/section-experiments"
    }
  ]
}
{% endschema %}
