<ss-conversion-block data-kind="payments" data-position="{{ block.settings.position | escape }}" data-full-width="{{ block.settings.full_width }}"  data-proxy="{{ block.settings.proxy_path | escape }}" data-wrap="{{ block.settings.wrap_section }}" data-design="{{ request.design_mode }}" data-add-url="{{ routes.cart_add_url }}.js" data-locale="{{ request.locale.iso_code }}" style="--cb-bg:{{ block.settings.background }};--cb-fg:{{ block.settings.foreground }};--cb-padding:{{ block.settings.padding }}px;--cb-radius:{{ block.settings.radius | default: 8 }}px;--cb-spacing:{{ block.settings.spacing | default: 0 }}px" class="cb-live cb-live-payments cb-live-{{ block.settings.layout }}" {{ block.shopify_attributes }}><h3><span data-cb-text="heading">{{ block.settings.heading | escape }}</span></h3><ul class="cb-live-list">{% for type in shop.enabled_payment_types %}<li>{{ type | payment_type_svg_tag }}</li>{% endfor %}</ul><p><span data-cb-text="custom">{{ block.settings.custom | escape }}</span></p>{% if block.settings.custom_icon != blank %}{{ block.settings.custom_icon | image_url: width: 80 | image_tag: loading: 'lazy' }}{% endif %}<span class="cb-live-status" role="status" aria-live="polite"></span></ss-conversion-block>
{% schema %}
{
  "name": "Payment icons",
  "target": "section",
  "stylesheet": "conversion-blocks.css",
  "javascript": "conversion-blocks.js",
  "settings": [
    {
      "id": "custom_icon",
      "label": "Custom payment icon",
      "type": "image_picker"
    },
    {
      "id": "heading",
      "label": "Heading",
      "type": "text",
      "default": "Secure payment"
    },
    {
      "id": "custom",
      "label": "Custom payment text",
      "type": "text",
      "default": "Other payment methods"
    },
    {
      "id": "background",
      "label": "Background",
      "type": "color",
      "default": "#f6f6f6"
    },
    {
      "id": "foreground",
      "label": "Text color",
      "type": "color",
      "default": "#202223"
    },
    {
      "id": "padding",
      "label": "Padding",
      "type": "range",
      "default": 16,
      "min": 0,
      "max": 48,
      "step": 1,
      "unit": "px"
    },
    {
      "id": "proxy_path",
      "label": "App proxy path",
      "type": "text",
      "default": "/apps/section-experiments"
    }
  ]
}
{% endschema %}
