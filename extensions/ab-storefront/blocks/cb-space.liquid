<ss-conversion-block data-kind="space" data-position="{{ block.settings.position | escape }}" data-full-width="{{ block.settings.full_width }}"  data-proxy="{{ block.settings.proxy_path | escape }}" data-wrap="{{ block.settings.wrap_section }}" data-design="{{ request.design_mode }}" data-add-url="{{ routes.cart_add_url }}.js" data-locale="{{ request.locale.iso_code }}" style="--cb-bg:{{ block.settings.background }};--cb-fg:{{ block.settings.foreground }};--cb-padding:{{ block.settings.padding }}px;--cb-radius:{{ block.settings.radius | default: 8 }}px;--cb-spacing:{{ block.settings.spacing | default: 0 }}px" class="cb-live cb-live-space cb-live-{{ block.settings.layout }}" {{ block.shopify_attributes }}>{% if block.settings.divider %}<hr>{% endif %}<span class="cb-live-status" role="status" aria-live="polite"></span></ss-conversion-block>
{% schema %}
{
  "name": "Space & divide",
  "target": "section",
  "stylesheet": "conversion-blocks.css",
  "javascript": "conversion-blocks.js",
  "settings": [
    {
      "id": "spacing",
      "label": "Spacing",
      "type": "range",
      "default": 24,
      "min": 0,
      "max": 80,
      "step": 1,
      "unit": "px"
    },
    {
      "id": "divider",
      "label": "Show horizontal divider",
      "type": "checkbox",
      "default": true
    },
    {
      "id": "background",
      "label": "Background",
      "type": "color",
      "default": "#f6f6f6"
    },
    {
      "id": "foreground",
      "label": "Text color",
      "type": "color",
      "default": "#202223"
    },
    {
      "id": "padding",
      "label": "Padding",
      "type": "range",
      "default": 16,
      "min": 0,
      "max": 48,
      "step": 1,
      "unit": "px"
    },
    {
      "id": "proxy_path",
      "label": "App proxy path",
      "type": "text",
      "default": "/apps/section-experiments"
    }
  ]
}
{% endschema %}
