<ss-conversion-block data-kind="pulse" data-position="{{ block.settings.position | escape }}" data-full-width="{{ block.settings.full_width }}" data-use-stock="{{ block.settings.use_stock }}" data-variants="{{ product.variants | json | escape }}" data-initial-variant="{{ product.selected_or_first_available_variant.id }}" data-stock-label="{{ block.settings.label | escape }}" data-unavailable-label="{{ block.settings.unavailable | escape }}" data-proxy="{{ block.settings.proxy_path | escape }}" data-wrap="{{ block.settings.wrap_section }}" data-design="{{ request.design_mode }}" data-add-url="{{ routes.cart_add_url }}.js" data-locale="{{ request.locale.iso_code }}" style="--cb-bg:{{ block.settings.background }};--cb-fg:{{ block.settings.foreground }};--cb-padding:{{ block.settings.padding }}px;--cb-radius:{{ block.settings.radius | default: 8 }}px;--cb-spacing:{{ block.settings.spacing | default: 0 }}px" class="cb-live cb-live-pulse cb-live-{{ block.settings.layout }}" {{ block.shopify_attributes }}><p class="cb-live-pulse">{% if block.settings.use_stock %}{% if product.selected_or_first_available_variant.available %}<span data-cb-text="label">{{ block.settings.label | escape }}</span>{% else %}<span data-cb-text="unavailable">{{ block.settings.unavailable | escape }}</span>{% endif %}{% else %}<span data-cb-text="label">{{ block.settings.label | escape }}</span>{% endif %}</p><span class="cb-live-status" role="status" aria-live="polite"></span></ss-conversion-block>
{% schema %}
{
  "name": "Pulse badge",
  "target": "section",
  "stylesheet": "conversion-blocks.css",
  "javascript": "conversion-blocks.js",
  "settings": [
    {
      "id": "use_stock",
      "label": "Use real product availability",
      "type": "checkbox",
      "default": true
    },
    {
      "id": "label",
      "label": "Available message",
      "type": "text",
      "default": "In stock"
    },
    {
      "id": "unavailable",
      "label": "Unavailable message",
      "type": "text",
      "default": "Sold out"
    },
    {
      "id": "background",
      "label": "Background",
      "type": "color",
      "default": "#f6f6f6"
    },
    {
      "id": "foreground",
      "label": "Text color",
      "type": "color",
      "default": "#202223"
    },
    {
      "id": "padding",
      "label": "Padding",
      "type": "range",
      "default": 16,
      "min": 0,
      "max": 48,
      "step": 1,
      "unit": "px"
    },
    {
      "id": "proxy_path",
      "label": "App proxy path",
      "type": "text",
      "default": "/apps/section-experiments"
    }
  ]
}
{% endschema %}
