<ss-conversion-block data-kind="video" data-position="{{ block.settings.position | escape }}" data-full-width="{{ block.settings.full_width }}"  data-proxy="{{ block.settings.proxy_path | escape }}" data-wrap="{{ block.settings.wrap_section }}" data-design="{{ request.design_mode }}" data-add-url="{{ routes.cart_add_url }}.js" data-locale="{{ request.locale.iso_code }}" style="--cb-bg:{{ block.settings.background }};--cb-fg:{{ block.settings.foreground }};--cb-padding:{{ block.settings.padding }}px;--cb-radius:{{ block.settings.radius | default: 8 }}px;--cb-spacing:{{ block.settings.spacing | default: 0 }}px" class="cb-live cb-live-video cb-live-{{ block.settings.layout }}" {{ block.shopify_attributes }}><h3><span data-cb-text="heading">{{ block.settings.heading | escape }}</span></h3><div class="cb-live-carousel" data-cb-carousel>{% if block.settings.video_1 != blank %}{{ block.settings.video_1 | video_tag: controls: true, preload: 'none' }}{% endif %}{% if block.settings.video_2 != blank %}{{ block.settings.video_2 | video_tag: controls: true, preload: 'none' }}{% endif %}</div><div class="cb-live-controls"><button type="button" data-cb-prev aria-label="Previous video">‹</button><button type="button" data-cb-next aria-label="Next video">›</button></div><span class="cb-live-status" role="status" aria-live="polite"></span></ss-conversion-block>
{% schema %}
{
  "name": "Video carousel",
  "target": "section",
  "stylesheet": "conversion-blocks.css",
  "javascript": "conversion-blocks.js",
  "settings": [
    {
      "id": "video_1",
      "label": "First video",
      "type": "video"
    },
    {
      "id": "video_2",
      "label": "Second video",
      "type": "video"
    },
    {
      "id": "heading",
      "label": "Heading",
      "type": "text",
      "default": "See it in action"
    },
    {
      "id": "background",
      "label": "Background",
      "type": "color",
      "default": "#f6f6f6"
    },
    {
      "id": "foreground",
      "label": "Text color",
      "type": "color",
      "default": "#202223"
    },
    {
      "id": "padding",
      "label": "Padding",
      "type": "range",
      "default": 16,
      "min": 0,
      "max": 48,
      "step": 1,
      "unit": "px"
    },
    {
      "id": "proxy_path",
      "label": "App proxy path",
      "type": "text",
      "default": "/apps/section-experiments"
    }
  ]
}
{% endschema %}
